extends layout

block content
  .container
    .row
      .col-md-6.col-md-offset-3
        h1 Create your druid archive
        p.text-muted Every form, one archive.
        form(method='GET', action='/login')
          .form-group
            label(for='username') Username
            input#username.form-control(type='text', name='username', value=demoUser.username)
          .form-group
            label(for='email') Email
            input#email.form-control(type='email', name='email', value=demoUser.email)
          .form-group
            label(for='password') Password
            input#password.form-control(type='password', name='password', value=demoUser.password)
          button.btn.btn-primary(type='submit') Create archive
          p.text-center.top-spacer Already in the circle? #[a(href='/login') Log in]
