extends layout

block content
  .container
    .row
      .col-md-6.col-md-offset-3
        h1 Welcome back
        p.text-muted Your Wild Shapes are waiting beneath the canopy.
        if error
          .alert.alert-danger= error
        form(method='POST', action='/login')
          .form-group
            label(for='email') Email
            input#email.form-control(type='email', name='email', required)
          .form-group
            label(for='password') Password
            input#password.form-control(type='password', name='password', required)
          button.btn.btn-primary(type='submit') Log in
          p.text-center.top-spacer New to Wildroot? #[a(href='/register') Create an account]
