extends layout

block content
  - function mod(score) { var m = Math.floor((score - 10) / 2); return (m >= 0 ? '+' : '') + m; }
  .wr-shell
    nav.wr-topnav
      .wr-topnav-left
        .wr-brand
          .wr-brand-mark.wr-brand-mark--sm
            svg(viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.6' stroke-linecap='round' stroke-linejoin='round')
              path(d='M4 20c0-8 4-15 15-16-1 11-8 15-15 16z')
              path(d='M6 18c3-4 6-7 10-12')
          .wr-brand-name
            span.wr-name Wildroot
            span.wr-tagline Druid companion
        .wr-nav
          a.wr-nav-item(href='/archive') Archive
          a.wr-nav-item.active(href='/archive/new')
            span.dot
            | Add Wild Shape
      .wr-profile
        .wr-avatar= profileInitials
        .wr-identity
          div.name= profileName
          div.sub= profileEmail
        a.wr-logout(href='/logout') Log out
    .wr-content
      .wr-heading
        p.wr-eyebrow Creature database
        h1 Wild Shape Archive
      .wr-tools
        .wr-filters
          a.wr-filter(class=activeTag ? '' : 'active', href='/archive')= 'All forms · ' + totalCount
          if allTags && allTags.length
            each tag in allTags
              a.wr-filter(class=activeTag === tag ? 'active' : '', href='/archive?tag=' + encodeURIComponent(tag))= tag
        a.wr-btn(href='/archive/new') + Add Wild Shape
      if wildShapes.length
        .wr-grid
          each ws in wildShapes
            .wr-card
              h2= ws.name
              p.wr-type= ws.size + ' ' + ws.creatureType + (ws.alignment ? ', ' + ws.alignment : '') + (ws.tags && ws.tags.length ? ' · ' + ws.tags.join(', ') : '')
              .wr-stats
                span= 'AC ' + ws.armorClass + (ws.armorClassNote ? ' (' + ws.armorClassNote + ')' : '')
                span= 'HP ' + ws.hitPoints + (ws.hitDice ? ' (' + ws.hitDice + ')' : '')
                span= 'Speed ' + ws.speed
                span= 'CR ' + ws.challengeRating + (ws.xp ? ' (' + ws.xp + ' XP)' : '')
                span.sheet-link(title='Creature sheet detail is not implemented yet') Open sheet →
              if ws.abilities
                .wr-abilities
                  each ab in ['str', 'dex', 'con', 'int', 'wis', 'cha']
                    span.wr-ability
                      span.wr-ability-label= ab.toUpperCase()
                      span.wr-ability-score= ws.abilities[ab] + ' (' + mod(ws.abilities[ab]) + ')'
              if (ws.savingThrows && ws.savingThrows.length) || (ws.skills && ws.skills.length)
                p.wr-sub-line
                  if ws.savingThrows && ws.savingThrows.length
                    strong Saving Throws
                    |  #{ws.savingThrows.join(', ')}
                  if ws.skills && ws.skills.length
                    |  #{ws.savingThrows && ws.savingThrows.length ? ' · ' : ''}
                    strong Skills
                    |  #{ws.skills.join(', ')}
              - var defenses = [];
              if ws.damageVulnerabilities && ws.damageVulnerabilities.length
                - defenses.push('Vulnerable: ' + ws.damageVulnerabilities.join(', '))
              if ws.damageResistances && ws.damageResistances.length
                - defenses.push('Resist: ' + ws.damageResistances.join(', '))
              if ws.damageImmunities && ws.damageImmunities.length
                - defenses.push('Immune: ' + ws.damageImmunities.join(', '))
              if ws.conditionImmunities && ws.conditionImmunities.length
                - defenses.push('Condition immune: ' + ws.conditionImmunities.join(', '))
              if defenses.length
                p.wr-sub-line= defenses.join(' · ')
              if ws.senses || ws.languages
                p.wr-sub-line
                  if ws.senses
                    strong Senses
                    |  #{ws.senses}
                  if ws.languages
                    |  #{ws.senses ? ' · ' : ''}
                    strong Languages
                    |  #{ws.languages}
              if ws.traits && ws.traits.length
                .wr-entries
                  strong.wr-entries-label Traits
                  each t in ws.traits
                    p.wr-entry
                      strong= t.name + '. '
                      = t.description
              if ws.actions && ws.actions.length
                .wr-entries
                  strong.wr-entries-label Actions
                  each a in ws.actions
                    p.wr-entry
                      strong= a.name + '. '
                      = a.description
        .wr-footer
          span= 'Showing ' + wildShapes.length + ' of ' + totalCount + ' creature records'
          span.sync Synced live from MongoDB
      else if activeTag
        .wr-empty
          p= 'No Wild Shapes tagged "' + activeTag + '".'
          a.wr-btn(href='/archive') ← Clear filter
      else
        .wr-empty
          p No Wild Shapes saved to your archive yet.
          a.wr-btn(href='/archive/new') + Add your first Wild Shape Wild Shape